{
  "name": "tiktok-focus",
  "description": "Custom TikTok fullscreen, local watch history, and playback resume",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome && node scripts/verify-build.mjs",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "^6.2.5",
    "linkedom": "^0.18.13",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.0.0",
    "vitest": "5.0.1",
    "wxt": "0.21.4"
  }
}
